{
  "name": "mangaink-agent",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @mangaink/frontend dev",
    "dev:backend": "pnpm --filter @mangaink/backend dev",
    "dev:full": "concurrently -n frontend,backend -c cyan,magenta \"pnpm dev\" \"pnpm dev:backend\"",
    "desktop:dev": "concurrently -n frontend,desktop -c cyan,magenta \"pnpm dev\" \"pnpm --filter @mangaink/desktop dev\"",
    "desktop:dev:embedded": "pnpm desktop:prepare:runtime && cross-env MI_EMBEDDED_MODE=1 pnpm desktop:dev",
    "build": "pnpm --filter @mangaink/frontend build",
    "build:backend": "pnpm --filter @mangaink/backend build",
    "desktop:build": "pnpm build && pnpm --filter @mangaink/desktop build",
    "desktop:prepare:backend": "node apps/desktop/scripts/prepare-backend.mjs",
    "desktop:prepare:runtime": "node apps/desktop/scripts/prepare-runtime.mjs",
    "desktop:dist": "pnpm build && pnpm desktop:prepare:runtime && pnpm desktop:prepare:backend && pnpm desktop:prepare:frontend && pnpm --filter @mangaink/desktop dist",
    "desktop:dist:setup": "pnpm build && pnpm desktop:prepare:runtime && pnpm desktop:prepare:backend && pnpm desktop:prepare:frontend && pnpm --filter @mangaink/desktop dist:setup",
    "desktop:dist:unpacked": "pnpm --filter @mangaink/desktop dist:unpacked",
    "lint": "node scripts/guard-npm-lock.mjs && pnpm -r lint",
    "format": "pnpm -r format",
    "storybook": "pnpm --filter @mangaink/frontend storybook",
    "db:migrate": "pnpm --filter @mangaink/backend db:migrate",
    "db:push": "pnpm --filter @mangaink/backend db:push",
    "db:generate": "pnpm --filter @mangaink/backend db:generate",
    "db:studio": "pnpm --filter @mangaink/backend db:studio",
    "test": "pnpm --filter @mangaink/backend test",
    "kcc:build": "docker build -f docker/Dockerfile.kcc -t mangaink-kcc:10.3.0 .",
    "mobi:build": "docker build -f docker/Dockerfile.mobiunpack -t mangaink-unpack:0.4.1 .",
    "docker:up": "docker compose -f apps/backend/docker-compose.yml up -d",
    "docker:down": "docker compose -f apps/backend/docker-compose.yml down",
    "monitoring:up": "docker compose -f docker/monitoring/docker-compose.yml up -d",
    "monitoring:down": "docker compose -f docker/monitoring/docker-compose.yml down",
    "monitoring:logs": "docker compose -f docker/monitoring/docker-compose.yml logs -f",
    "desktop:prepare:frontend": "node apps/desktop/scripts/prepare-frontend.mjs",
    "desktop:prepare:resources": "node apps/desktop/scripts/prepare-tauri-resources.mjs"
  },
  "devDependencies": {
    "concurrently": "^10.0.3",
    "cross-env": "^7.0.3"
  }
}