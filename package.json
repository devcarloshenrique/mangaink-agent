{
  "name": "mangaink-agent",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @mangaink/frontend dev",
    "dev:backend": "pnpm --filter @mangaink/backend dev",
    "dev:full": "concurrently -n frontend,backend -c cyan,magenta \"pnpm dev\" \"pnpm dev:backend\"",
    "build": "pnpm --filter @mangaink/frontend build",
    "build:backend": "pnpm --filter @mangaink/backend build",
    "lint": "pnpm -r lint",
    "format": "pnpm -r format",
    "storybook": "pnpm --filter @mangaink/frontend storybook",
    "db:migrate": "pnpm --filter @mangaink/backend db:migrate",
    "db:push": "pnpm --filter @mangaink/backend db:push",
    "db:generate": "pnpm --filter @mangaink/backend db:generate",
    "db:studio": "pnpm --filter @mangaink/backend db:studio",
    "test": "pnpm --filter @mangaink/backend test"
  },
  "devDependencies": {
    "concurrently": "^10.0.3"
  }
}
