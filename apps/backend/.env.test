# -------------------------------------------------------------
# Ambiente de Testes (@mangaink/backend) (.env.test)
# -------------------------------------------------------------
NODE_ENV=test
PORT=3334

# -- Segurança -------------------------------------------------
JWT_SECRET=test-secret-supersafe-for-vitest
X_API_TOKEN=test-britannia-token

# -- Banco de Dados (testes de integração/e2e) -----------------
DATABASE_URL=postgresql://mangaink:mangaink@localhost:5432/mangaink_agent_test_db

# -- Modo Embedded ---------------------------------------------
# Default 0 nos testes (testes embedded ativam pontualmente via vi.stubEnv)
MI_EMBEDDED_MODE=0

# -- OpenTelemetry ---------------------------------------------
OTEL_SDK_DISABLED=true
