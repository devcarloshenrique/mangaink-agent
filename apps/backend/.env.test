# ── Ambiente ───────────────────────────────────────────────
# Opções: dev | test | production
NODE_ENV=test

# ── Servidor ──────────────────────────────────────────────
# Default: 3333
PORT=3334

# ── Segurança ─────────────────────────────────────────────
# Obrigatório — chave secreta para assinatura JWT
JWT_SECRET=test-secret-supersafe-for-vitest

# ── Banco de Dados ────────────────────────────────────────
# Obrigatório — URL de conexão PostgreSQL
# Formato: postgresql://<user>:<pass>@<host>:<port>/<db>
DATABASE_URL=postgresql://mangaink:mangaink@localhost:5432/mangaink_agent_test_db

# ── Cache / Filas ─────────────────────────────────────────
# Default: redis://localhost:6379
# Ignorado quando MI_EMBEDDED_MODE=1 (filas in-memory)
REDIS_URL=redis://localhost:6379

# ── Modo Embedded (app desktop) ───────────────────────────
# '1'/'true' → filas in-memory + KCC/extract_mobi via python embutido (sem Docker/Redis).
# Nos testes o modo embedded é ativado pontualmente via vi.stubEnv('MI_EMBEDDED_MODE', '1');
# manter =0 aqui para o default dos testes seguir o modo web.
MI_EMBEDDED_MODE=0

# Raiz do runtime embutido (usado apenas com MI_EMBEDDED_MODE=1).
# Nos testes embedded os runners são mockados; em dev standalone:
# MI_EMBEDDED_RUNTIME_PATH=C:\caminho\para\apps\desktop\resources\runtime
# MI_EMBEDDED_RUNTIME_PATH=

# ── Storage ───────────────────────────────────────────────
# Default: ./storage
# Diretório raiz para cache de scraping (sources/) e saída de conversões
STORAGE_PATH=./storage

# Default: ./storage/conversions
# Diretório para conversões (config.json, status.json, output/)
CONVERSIONS_STORAGE_PATH=./storage/conversions

# ── KCC (Kindle Comic Converter) ──────────────────────────
# Default: mangaink-kcc:10.3.0
# Imagem Docker usada pelo kcc-runner.service.ts
KCC_DOCKER_IMAGE=mangaink-kcc:10.3.0

# ── MOBI Preview no navegador ────────────────────────────
# Imagem Docker usada para extrair paginas de MOBI
MOBI_DOCKER_IMAGE=mangaink-unpack:0.4.1
# TTL (segundos) do cache de preview em /temp (default 24h)
MOBI_PREVIEW_TTL_SEC=86400

# ── Job Status TTL ────────────────────────────────────────
# TTL (segundos) do Hash Redis para status live de Jobs
JOB_STATUS_TTL_SEC=21600

# ── User Presets ──────────────────────────────────────────
MAX_USER_PRESETS=20

# Postgres via Prisma é o único backend de persistência (sem opção filesystem)

# Desliga instrumentação nos testes
OTEL_SDK_DISABLED=true
