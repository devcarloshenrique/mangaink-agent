# -------------------------------------------------------------
# MangaInk Agent - Backend Configuration Template (.env.example)
# Copie este arquivo para .env e ajuste os valores conforme seu ambiente.
# -------------------------------------------------------------

# -- Ambiente --------------------------------------------------
# Opções: dev | test | production (default: dev)
NODE_ENV=dev

# -- Servidor --------------------------------------------------
# Porta do servidor Fastify (default: 3333)
PORT=3333

# -- Segurança -------------------------------------------------
# Obrigatório: Chave secreta para assinatura de tokens JWT (mínimo 32 caracteres)
# Nunca use valores padrão em produção! Gere com: openssl rand -hex 32
JWT_SECRET=your-secure-random-jwt-secret-at-least-32-chars-long

# Obrigatório: Token da API do Império da Britânnia
X_API_TOKEN=your-britannia-api-token-here

# -- Banco de Dados (docker-compose) ---------------------------
# Configuração usada pelo PostgreSQL no docker-compose.yml
POSTGRES_DB=mangaink_agent_db
POSTGRES_PORT=5432
POSTGRES_USER=mangaink
POSTGRES_PASSWORD=mangaink

# -- Banco de Dados (Conexão da Aplicação) ---------------------
# Obrigatório: URL de conexão PostgreSQL usada pelo Prisma
# Formato: postgresql://<user>:<pass>@<host>:<port>/<db>?schema=public
DATABASE_URL=postgresql://mangaink:mangaink@localhost:5432/mangaink_agent_db?schema=public

# -- Cache e Filas (Redis) -------------------------------------
# Default: redis://localhost:6379
# Ignorado quando MI_EMBEDDED_MODE=1 (pois usa filas e pubsub in-memory)
REDIS_URL=redis://localhost:6379

# -- Modo Embedded (Desktop Tauri) -----------------------------
# Default: 0 (modo web com Redis + Docker + PostgreSQL externo)
# '1'/'true' -> Filas in-memory + KCC/extract_mobi via Python embutido
# O desktop empacotado configura automaticamente em tempo de execução.
MI_EMBEDDED_MODE=0

# Raiz do runtime embutido (usado apenas com MI_EMBEDDED_MODE=1)
# MI_EMBEDDED_RUNTIME_PATH=C:\caminho\para\apps\desktop\resources\runtime

# -- Storage ---------------------------------------------------
# Diretório raiz para cache de scraping e armazenamento geral (default: ./storage)
STORAGE_PATH=./storage

# Diretório para jobs de conversão (default: ./storage/conversions)
CONVERSIONS_STORAGE_PATH=./storage/conversions

# -- KCC (Kindle Comic Converter - Modo Web) -------------------
# Imagem Docker usada para conversões no modo web (default: mangaink-kcc:10.3.0)
KCC_DOCKER_IMAGE=mangaink-kcc:10.3.0

# -- MOBI Preview no Navegador (Modo Web) ----------------------
# Imagem Docker usada para extrair páginas de arquivos MOBI (default: mangaink-unpack:0.4.1)
MOBI_DOCKER_IMAGE=mangaink-unpack:0.4.1
# TTL (segundos) do cache de preview em /temp (default: 86400 -> 24h)
MOBI_PREVIEW_TTL_SEC=86400

# -- TTLs e Limites --------------------------------------------
# TTL (segundos) do Hash Redis para status live de Jobs (default: 21600 -> 6h)
JOB_STATUS_TTL_SEC=21600

# Limite máximo de presets de conversão por usuário (default: 20)
MAX_USER_PRESETS=20

# -- Documentação Swagger / OpenAPI ----------------------------
# true | false (default: ativo em dev/test, desativado em production)
# SWAGGER_ENABLED=true

# -- Limpeza de Storage Órfão ----------------------------------
# Intervalo de varredura do sweeper em ms (default: 21600000 -> 6h)
STORAGE_SWEEPER_INTERVAL_MS=21600000
# Idade mínima do diretório órfão para exclusão em ms (default: 86400000 -> 24h)
STORAGE_SWEEPER_MIN_ORPHAN_AGE_MS=86400000

# -- OpenTelemetry (Observabilidade) ---------------------------
# Endpoint OTLP gRPC (default: http://127.0.0.1:4317)
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4317
OTEL_SERVICE_NAME=mangaink-api
OTEL_METRICS_EXPORT_INTERVAL_MS=10000

# Desativa instrumentação OTel (default: false em prod/dev, true em testes/desktop)
OTEL_SDK_DISABLED=true
