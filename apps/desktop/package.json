{
  "name": "@mangaink/desktop",
  "version": "0.1.1",
  "private": true,
  "description": "App desktop do MangaInk Agent (shell Tauri v2)",
  "author": {
    "name": "MangaInk Agent",
    "email": "dev@mangaink.app"
  },
  "type": "module",
  "scripts": {
    "dev": "tauri dev --config src-tauri/tauri.conf.dev.json",
    "build": "tauri build",
    "prepare:runtime": "node scripts/prepare-runtime.mjs",
    "prepare:resources": "node scripts/prepare-tauri-resources.mjs",
    "dist": "node scripts/prepare-tauri-resources.mjs && node scripts/tauri-build-config.mjs && node scripts/build-distributions.mjs unpacked",
    "dist:setup": "node scripts/prepare-tauri-resources.mjs && node scripts/tauri-build-config.mjs",
    "dist:unpacked": "node scripts/build-distributions.mjs unpacked"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4"
  }
}